name: Transifex 🗺

on:
  push:
    branches:
      - main
    paths:
      - '**.py'
      - '**.ui'


jobs:
  push:
    name: Push to Transifex
    runs-on: ubuntu-latest
    if: github.repository == 'QuickOSM/QuickOSM'

    steps:
    - uses: actions/checkout@v7

    - name: Set up Python 3.10
      uses: actions/setup-python@v7
      with:
        python-version: '3.10'

    - name: Install Python QGIS-Plugin-CI
      run: pip install git+https://github.com/qgis/qgis-plugin-ci.git@local-ts-files

    - name: Push to Transifex
      run: qgis-plugin-ci push-translation ${{ secrets.TRANSIFEX_TOKEN }}
